# --- LLM (any OpenAI-compatible chat completions API) ---
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Optional overrides (defaults shown):
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# Model used for cheap internal steps (intent routing, claim extraction). Defaults to MODEL.
FAST_MODEL=

# --- Web search: set ONE of these ---
# Brave Search API key: https://brave.com/search/api/  (free tier available)
BRAVE_API_KEY=
# Tavily API key: https://tavily.com  (free tier available)
TAVILY_API_KEY=

# --- Server ---
PORT=3000
